# Database Connection
# Replace with your actual database credentials
DATABASE_URL="postgresql://user:password@host:5432/database?schema=schoolmanagementsystem"
DIRECT_URL="postgresql://user:password@host:5432/database?schema=schoolmanagementsystem"

# Security - GENERATE A STRONG SECRET (minimum 32 characters)
# Run this command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secret-here-min-32-characters"

# API Keys (optional)
GEMINI_API_KEY=""

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
