generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["schoolmanagementsystem"]
}

model School {
  id               String             @id @default(cuid())
  name             String
  settings_json    Json?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  books            Book[]
  buses            Bus[]
  Exam             Exam[]
  Expense          Expense[]
  GateLog          GateLog[]
  Homework         Homework[]
  HostelRoom       HostelRoom[]
  Inquiry          Inquiry[]
  invoices         Invoice[]
  LeaveApplication LeaveApplication[]
  LiveClass        LiveClass[]
  Paper            Paper[]
  Result           Result[]
  students         Student[]
  Substitution     Substitution[]
  Syllabus         Syllabus[]
  SystemSettings   SystemSettings?
  Ticket           Ticket[]
  Timetable        Timetable[]
  users            User[]
  Visitor          Visitor[]

  @@schema("schoolmanagementsystem")
}

model User {
  id                                                    String             @id @default(cuid())
  name                                                  String
  email                                                 String             @unique
  phone                                                 String?
  password_hash                                         String
  role                                                  UserRole
  department                                            String?
  school_id                                             String
  created_at                                            DateTime           @default(now())
  updated_at                                            DateTime           @updatedAt
  documents                                             IdentityDocument[]
  LeaveApplication                                      LeaveApplication[]
  LiveClass                                             LiveClass[]
  parent_links                                          ParentStudent[]
  Substitution_Substitution_original_teacher_idToUser   Substitution[]     @relation("Substitution_original_teacher_idToUser")
  Substitution_Substitution_substitute_teacher_idToUser Substitution[]     @relation("Substitution_substitute_teacher_idToUser")
  Syllabus                                              Syllabus[]
  Ticket                                                Ticket[]
  Timetable                                             Timetable[]
  school                                                School             @relation(fields: [school_id], references: [id])

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model Student {
  id           String             @id @default(cuid())
  admission_no String
  name         String
  email        String?            @unique
  class        String
  roll         Int
  school_id    String
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  attendance   Attendance[]
  counseling   Counseling[]
  HostelRoom   HostelRoom[]
  documents    IdentityDocument[]
  invoices     Invoice[]
  medical_logs MedicalLog[]
  parents      ParentStudent[]
  Result       Result[]
  school       School             @relation(fields: [school_id], references: [id])
  Visitor      Visitor[]

  @@unique([school_id, admission_no])
  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model ParentStudent {
  parent_id  String
  student_id String
  school_id  String
  relation   String
  is_primary Boolean @default(false)
  parent     User    @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@id([parent_id, student_id])
  @@schema("schoolmanagementsystem")
}

model IdentityDocument {
  id                  String         @id @default(cuid())
  owner_user_id       String?
  owner_student_id    String?
  doc_type            String
  file_ref            String
  masked_id           String?
  verification_status DocumentStatus @default(PENDING)
  school_id           String
  created_at          DateTime       @default(now())
  owner_student       Student?       @relation(fields: [owner_student_id], references: [id])
  owner_user          User?          @relation(fields: [owner_user_id], references: [id])

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model Bus {
  id              String   @id @default(cuid())
  plateNumber     String   @unique
  driverName      String
  capacity        Int
  routeId         String
  insuranceExpiry DateTime
  school_id       String
  school          School   @relation(fields: [school_id], references: [id])

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model Book {
  isbn      String  @id
  title     String
  author    String
  status    String
  issuedTo  String?
  school_id String
  school    School  @relation(fields: [school_id], references: [id])

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model Invoice {
  id              String        @id @default(cuid())
  student_id      String
  base_amount     Float
  discount_amount Float
  description     String
  due_date        DateTime
  status          InvoiceStatus @default(PENDING)
  utr             String?
  school_id       String
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  school          School        @relation(fields: [school_id], references: [id])
  student         Student       @relation(fields: [student_id], references: [id])

  @@index([school_id])
  @@index([student_id])
  @@schema("schoolmanagementsystem")
}

model Attendance {
  id         String           @id @default(cuid())
  student_id String
  date       DateTime
  status     AttendanceStatus
  synced     Boolean          @default(false)
  school_id  String
  student    Student          @relation(fields: [student_id], references: [id])

  @@index([school_id])
  @@index([student_id])
  @@schema("schoolmanagementsystem")
}

model MedicalLog {
  id         String   @id @default(cuid())
  student_id String
  time       DateTime
  issue      String
  action     String
  school_id  String
  student    Student  @relation(fields: [student_id], references: [id])

  @@index([school_id])
  @@index([student_id])
  @@schema("schoolmanagementsystem")
}

model Counseling {
  id         String   @id @default(cuid())
  student_id String
  category   String
  note       String
  date       DateTime
  school_id  String
  student    Student  @relation(fields: [student_id], references: [id])

  @@index([school_id])
  @@index([student_id])
  @@schema("schoolmanagementsystem")
}

model Expense {
  id          String          @id
  school_id   String
  category    ExpenseCategory
  amount      Float
  description String?
  date        DateTime?       @default(now()) @db.Timestamptz(6)
  School      School          @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model Homework {
  id          String          @id
  school_id   String
  title       String
  subject     String
  description String?
  due_date    DateTime        @db.Timestamptz(6)
  status      HomeworkStatus? @default(PENDING)
  class_id    String
  created_at  DateTime?       @default(now()) @db.Timestamptz(6)
  School      School          @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model HostelRoom {
  id          String    @id
  school_id   String
  room_number String
  student_id  String?
  capacity    Int?      @default(1)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  School      School    @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Student     Student?  @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model Inquiry {
  id           Int            @id @default(autoincrement())
  school_id    String
  parent_name  String
  phone        String
  target_class String?
  status       InquiryStatus? @default(NEW)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  School       School         @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model LeaveApplication {
  id         String       @id
  school_id  String
  user_id    String
  type       LeaveType
  start_date DateTime     @db.Timestamptz(6)
  end_date   DateTime     @db.Timestamptz(6)
  reason     String?
  status     LeaveStatus? @default(PENDING)
  created_at DateTime?    @default(now()) @db.Timestamptz(6)
  School     School       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User       User         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model Ticket {
  id          String          @id
  school_id   String
  location    String
  issue       String
  priority    TicketPriority? @default(MEDIUM)
  status      TicketStatus?   @default(OPEN)
  reported_by String
  created_at  DateTime?       @default(now()) @db.Timestamptz(6)
  User        User            @relation(fields: [reported_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  School      School          @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model Visitor {
  id         Int            @id @default(autoincrement())
  school_id  String
  name       String
  student_id String?
  purpose    String
  status     VisitorStatus? @default(WAITING)
  time       DateTime?      @default(now()) @db.Timestamptz(6)
  School     School         @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Student    Student?       @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model Exam {
  id         String    @id
  school_id  String
  name       String
  type       ExamType? @default(INTERNAL)
  start_date DateTime  @db.Timestamptz(6)
  end_date   DateTime  @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  School     School    @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Result     Result[]

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model GateLog {
  id          Int            @id @default(autoincrement())
  school_id   String
  person_type GatePersonType
  person_id   String?
  name        String
  purpose     String
  status      GateStatus?    @default(INSIDE)
  entry_time  DateTime?      @default(now()) @db.Timestamptz(6)
  exit_time   DateTime?      @db.Timestamptz(6)
  School      School         @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
  @@schema("schoolmanagementsystem")
}

model LiveClass {
  id           String    @id
  school_id    String
  subject      String
  class_id     String
  teacher_id   String
  meeting_link String
  is_active    Boolean?  @default(false)
  start_time   DateTime? @default(now()) @db.Timestamptz(6)
  School       School    @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User         User      @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model Paper {
  id         String       @id
  school_id  String
  title      String
  subject    String
  class_id   String
  status     PaperStatus? @default(DRAFT)
  created_at DateTime?    @default(now()) @db.Timestamptz(6)
  School     School       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model Result {
  id               String    @id
  school_id        String
  exam_id          String
  student_id       String
  subject_marks    Json
  total_percentage Float?
  grade            String?
  remarks          String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  Exam             Exam      @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  School           School    @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Student          Student   @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model Substitution {
  id                                            String     @id
  school_id                                     String
  date                                          DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  original_teacher_id                           String?
  substitute_teacher_id                         String?
  timetable_id                                  String?
  User_Substitution_original_teacher_idToUser   User?      @relation("Substitution_original_teacher_idToUser", fields: [original_teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  School                                        School     @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User_Substitution_substitute_teacher_idToUser User?      @relation("Substitution_substitute_teacher_idToUser", fields: [substitute_teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Timetable                                     Timetable? @relation(fields: [timetable_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model Syllabus {
  id           String          @id
  school_id    String
  subject      String
  class_id     String
  topic        String
  status       SyllabusStatus? @default(NOT_STARTED)
  teacher_id   String?
  completed_at DateTime?       @db.Timestamptz(6)
  School       School          @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User         User?           @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model SystemSettings {
  school_id           String    @id
  lockdown_mode       Boolean?  @default(false)
  low_data_mode       Boolean?  @default(false)
  announcement_ticker String?
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  School              School    @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("schoolmanagementsystem")
}

model Timetable {
  id           String         @id
  school_id    String
  class_id     String
  day_of_week  Int
  start_time   String
  end_time     String
  subject      String
  teacher_id   String?
  Substitution Substitution[]
  School       School         @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User         User?          @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([class_id])
  @@schema("schoolmanagementsystem")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  HOD
  TEACHER
  ACCOUNTANT
  FINANCE_MANAGER
  FLEET_MANAGER
  ADMISSIONS_OFFICER
  EXAM_CELL
  LIBRARIAN
  WARDEN
  NURSE
  COUNSELOR
  INVENTORY_MANAGER
  RECEPTIONIST
  IT_ADMIN
  SECURITY_HEAD
  ESTATE_MANAGER
  PARENT
  STUDENT

  @@schema("schoolmanagementsystem")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE

  @@schema("schoolmanagementsystem")
}

enum InvoiceStatus {
  PENDING
  VERIFIED
  PAID

  @@schema("schoolmanagementsystem")
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("schoolmanagementsystem")
}

enum ExpenseCategory {
  UTILITY
  VENDOR
  SALARY
  MAINTENANCE

  @@schema("schoolmanagementsystem")
}

enum HomeworkStatus {
  PENDING
  SUBMITTED
  GRADED

  @@schema("schoolmanagementsystem")
}

enum InquiryStatus {
  NEW
  FOLLOW_UP
  CONVERTED

  @@schema("schoolmanagementsystem")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("schoolmanagementsystem")
}

enum LeaveType {
  SICK
  CASUAL
  EARNED

  @@schema("schoolmanagementsystem")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("schoolmanagementsystem")
}

enum TicketStatus {
  OPEN
  RESOLVED
  ASSIGNED
  PENDING

  @@schema("schoolmanagementsystem")
}

enum VisitorStatus {
  WAITING
  APPROVED
  COMPLETED

  @@schema("schoolmanagementsystem")
}

enum ExamType {
  INTERNAL
  MIDTERM
  FINAL

  @@schema("schoolmanagementsystem")
}

enum GatePersonType {
  STUDENT
  STAFF
  VISITOR

  @@schema("schoolmanagementsystem")
}

enum GateStatus {
  INSIDE
  EXITED

  @@schema("schoolmanagementsystem")
}

enum PaperStatus {
  DRAFT
  PRINTED
  DISTRIBUTED

  @@schema("schoolmanagementsystem")
}

enum SyllabusStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@schema("schoolmanagementsystem")
}
