generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model School {
  id               String             @id @default(cuid())
  name             String
  settings_json    Json?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  books            Book[]
  buses            Bus[]
  Expense          Expense[]
  Homework         Homework[]
  HostelRoom       HostelRoom[]
  Inquiry          Inquiry[]
  invoices         Invoice[]
  LeaveApplication LeaveApplication[]
  students         Student[]
  Ticket           Ticket[]
  users            User[]
  Visitor          Visitor[]
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  phone            String?
  password_hash    String
  role             UserRole
  department       String?
  school_id        String
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  documents        IdentityDocument[]
  LeaveApplication LeaveApplication[]
  parent_links     ParentStudent[]
  Ticket           Ticket[]
  school           School             @relation(fields: [school_id], references: [id])

  @@index([school_id])
}

model Student {
  id           String             @id @default(cuid())
  admission_no String
  name         String
  email        String?            @unique
  class        String
  roll         Int
  school_id    String
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  attendance   Attendance[]
  counseling   Counseling[]
  HostelRoom   HostelRoom[]
  documents    IdentityDocument[]
  invoices     Invoice[]
  medical_logs MedicalLog[]
  parents      ParentStudent[]
  school       School             @relation(fields: [school_id], references: [id])
  Visitor      Visitor[]

  @@unique([school_id, admission_no])
  @@index([school_id])
}

model ParentStudent {
  parent_id  String
  student_id String
  school_id  String
  relation   String
  is_primary Boolean @default(false)
  parent     User    @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@id([parent_id, student_id])
}

model IdentityDocument {
  id                  String         @id @default(cuid())
  owner_user_id       String?
  owner_student_id    String?
  doc_type            String
  file_ref            String
  masked_id           String?
  verification_status DocumentStatus @default(PENDING)
  school_id           String
  created_at          DateTime       @default(now())
  owner_student       Student?       @relation(fields: [owner_student_id], references: [id])
  owner_user          User?          @relation(fields: [owner_user_id], references: [id])

  @@index([school_id])
}

model Bus {
  id              String   @id @default(cuid())
  plateNumber     String   @unique
  driverName      String
  capacity        Int
  routeId         String
  insuranceExpiry DateTime
  school_id       String
  school          School   @relation(fields: [school_id], references: [id])

  @@index([school_id])
}

model Book {
  isbn      String  @id
  title     String
  author    String
  status    String
  issuedTo  String?
  school_id String
  school    School  @relation(fields: [school_id], references: [id])

  @@index([school_id])
}

model Invoice {
  id              String        @id @default(cuid())
  student_id      String
  base_amount     Float
  discount_amount Float
  description     String
  due_date        DateTime
  status          InvoiceStatus @default(PENDING)
  utr             String?
  school_id       String
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  school          School        @relation(fields: [school_id], references: [id])
  student         Student       @relation(fields: [student_id], references: [id])

  @@index([school_id])
  @@index([student_id])
}

model Attendance {
  id         String           @id @default(cuid())
  student_id String
  date       DateTime
  status     AttendanceStatus
  synced     Boolean          @default(false)
  school_id  String
  student    Student          @relation(fields: [student_id], references: [id])

  @@index([school_id])
  @@index([student_id])
}

model MedicalLog {
  id         String   @id @default(cuid())
  student_id String
  time       DateTime
  issue      String
  action     String
  school_id  String
  student    Student  @relation(fields: [student_id], references: [id])

  @@index([school_id])
  @@index([student_id])
}

model Counseling {
  id         String   @id @default(cuid())
  student_id String
  category   String
  note       String
  date       DateTime
  school_id  String
  student    Student  @relation(fields: [student_id], references: [id])

  @@index([school_id])
  @@index([student_id])
}

model Expense {
  id          String          @id
  school_id   String
  category    ExpenseCategory
  amount      Float
  description String?
  date        DateTime?       @default(now()) @db.Timestamptz(6)
  School      School          @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
}

model Homework {
  id          String          @id
  school_id   String
  title       String
  subject     String
  description String?
  due_date    DateTime        @db.Timestamptz(6)
  status      HomeworkStatus? @default(PENDING)
  class_id    String
  created_at  DateTime?       @default(now()) @db.Timestamptz(6)
  School      School          @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
}

model HostelRoom {
  id          String    @id
  school_id   String
  room_number String
  student_id  String?
  capacity    Int?      @default(1)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  School      School    @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Student     Student?  @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Inquiry {
  id           Int            @id @default(autoincrement())
  school_id    String
  parent_name  String
  phone        String
  target_class String?
  status       InquiryStatus? @default(NEW)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  School       School         @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model LeaveApplication {
  id         String       @id
  school_id  String
  user_id    String
  type       LeaveType
  start_date DateTime     @db.Timestamptz(6)
  end_date   DateTime     @db.Timestamptz(6)
  reason     String?
  status     LeaveStatus? @default(PENDING)
  created_at DateTime?    @default(now()) @db.Timestamptz(6)
  School     School       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User       User         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
}

model Ticket {
  id          String          @id
  school_id   String
  location    String
  issue       String
  priority    TicketPriority? @default(MEDIUM)
  status      TicketStatus?   @default(OPEN)
  reported_by String
  created_at  DateTime?       @default(now()) @db.Timestamptz(6)
  User        User            @relation(fields: [reported_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  School      School          @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id])
}

model Visitor {
  id         Int            @id @default(autoincrement())
  school_id  String
  name       String
  student_id String?
  purpose    String
  status     VisitorStatus? @default(WAITING)
  time       DateTime?      @default(now()) @db.Timestamptz(6)
  School     School         @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Student    Student?       @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  HOD
  TEACHER
  ACCOUNTANT
  FINANCE_MANAGER
  FLEET_MANAGER
  ADMISSIONS_OFFICER
  EXAM_CELL
  LIBRARIAN
  WARDEN
  NURSE
  COUNSELOR
  INVENTORY_MANAGER
  RECEPTIONIST
  IT_ADMIN
  SECURITY_HEAD
  ESTATE_MANAGER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum InvoiceStatus {
  PENDING
  VERIFIED
  PAID
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ExpenseCategory {
  UTILITY
  VENDOR
  SALARY
  MAINTENANCE
}

enum HomeworkStatus {
  PENDING
  SUBMITTED
  GRADED
}

enum InquiryStatus {
  NEW
  FOLLOW_UP
  CONVERTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  RESOLVED
  ASSIGNED
  PENDING
}

enum VisitorStatus {
  WAITING
  APPROVED
  COMPLETED
}
